#!/home/deku/Friday/venv/bin/python3
import sys
import os
import numpy as np
import openwakeword
from openwakeword.model import Model
import sounddevice as sd

# Simple script to detect wake words and print to stdout
# This mimics what the Friday assistant expects from an 'openwakeword' binary

def main():
    # Load model with all available pre-trained models
    model = Model()

    # Print available models so the caller knows what wake words are active
    print(f"DEBUG: Loaded wake-word models: {list(model.models.keys())}", file=sys.stderr)
    sys.stderr.flush()

    device = os.getenv("OPENWAKEWORD_DEVICE") or os.getenv("AUDIODEV")
    if device is not None:
        try:
            device = int(device)
        except ValueError:
            pass

    if device is not None:
        print(f"DEBUG: Using audio device: {device}", file=sys.stderr)
        sys.stderr.flush()

    # Define callback
    def callback(indata, frames, time, status):
        if status:
            print(status, file=sys.stderr)
            sys.stderr.flush()

        # Volume: normalize int16 range to 0..1 before computing norm
        vol = np.linalg.norm(indata.astype(np.float32) / 32768.0) * 10
        if vol > 1.5:
            print(f"DEBUG: Mic volume {vol:.2f}", file=sys.stderr)
            sys.stderr.flush()

        # Get predictions
        # openWakeWord's preprocessor requires raw int16 data — do NOT convert to float.
        # The InputStream is already opened with dtype='int16' so indata[:,0] is int16.
        try:
            prediction = model.predict(indata[:, 0])
        except Exception as exc:
            print(f"DEBUG: predict() error: {exc}", file=sys.stderr)
            sys.stderr.flush()
            return

        # Check for detections
        for kw, score in prediction.items():
            if score > 0.5:
                # Print the keyword name to stdout — the wrapper calls on_detect with this text
                print(kw, flush=True)
            # Diagnostic: near-miss scores (lowered threshold so we can see activity)
            elif score > 0.05:
                print(f"DEBUG: Near-miss '{kw}' score={score:.3f}", file=sys.stderr)
                sys.stderr.flush()

    # Print device info to stderr
    print(f"DEBUG: Audio devices:\n{sd.query_devices()}", file=sys.stderr)
    sys.stderr.flush()

    # Start streaming
    try:
        if device is not None:
            with sd.InputStream(device=device, channels=1, samplerate=16000, callback=callback, blocksize=1280, dtype='int16'):
                while True:
                    sd.sleep(1000)
        else:
            with sd.InputStream(channels=1, samplerate=16000, callback=callback, blocksize=1280, dtype='int16'):
                while True:
                    sd.sleep(1000)
    except ValueError as e:
        print(f"Audio Configuration Error: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)
